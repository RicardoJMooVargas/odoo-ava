        <field name="model">hr.sales.scheme</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expediente_empleados.report_hr_sales_scheme_document</field>
        <field name="report_file">expediente_empleados.report_hr_sales_scheme_document</field>
        <field name="print_report_name">'ESQUEMA_METAS_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hr_sales_scheme"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_hr_sales_legal_observation" model="ir.actions.report">
        <field name="name">Imprimir Acta de Observación y Mejora - Sección VIII (PDF)</field>
        <field name="model">hr.sales.legal.observation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">expediente_empleados.report_hr_sales_legal_observation_document</field>
        <field name="report_file">expediente_empleados.report_hr_sales_legal_observation_document</field>
        <field name="print_report_name">'ACTA_OBSERVACION_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hr_sales_legal_observation"/>
