<odoo>
    <record id="view_employee_form_expediente" model="ir.ui.view">
        <field name="name">hr.employee.form.expediente</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Expediente laboral" name="expediente_laboral">
                    <group>
                        <group string="Datos laborales">
                            <field name="fecha_ingreso"/>
                            <field name="puesto_expediente"/>
                            <field name="division"/>
                            <field name="estatus_expediente"/>
                            <field name="es_chofer"/>
                            <field name="no_seguro_social"/>
                        </group>
                    </group>

                    <separator string="Documentos principales"/>
                    <group>
                        <group>
                            <field name="comp_domic_ids" widget="many2many_binary" string="Comprobante de domicilio"/>
                            <field name="const_sit_fiscal_ids" widget="many2many_binary" string="Constancia de situación fiscal"/>
                            <field name="ine_ids" widget="many2many_binary" string="INE"/>
                        </group>
                        <group>
                            <field name="curp_ids" widget="many2many_binary" string="CURP"/>
                            <field name="rfc_ids" widget="many2many_binary" string="RFC"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documentos laborales">
                            <group>
                                <group>
                                    <field name="solicitud_empl_ids" widget="many2many_binary" string="Solicitud de empleo"/>
                                    <field name="contrato_ids" widget="many2many_binary" string="Contrato"/>
                                    <field name="descript_puesto_ids" widget="many2many_binary" string="Descripción de puesto"/>
                                </group>
                                <group>
                                    <field name="licencia_chof_ids" widget="many2many_binary" string="Licencia de conducir"/>
                                    <field name="act_naci_ids" widget="many2many_binary" string="Acta de nacimiento"/>
                                    <field name="acta_hechos_ids" widget="many2many_binary" string="Acta de hechos"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <field name="observaciones_expediente" placeholder="Notas del expediente..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
