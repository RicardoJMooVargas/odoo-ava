<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista dedicada directa para el menú "Configuración AVA_API" -->
    <record id="view_ava_api_config_settings_standalone_form" model="ir.ui.view">
        <field name="name">res.config.settings.ava.api.standalone.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <form string="Configuración de Claves y Acceso a AVA_API">
                <header>
                    <button name="action_save_ava_config"
                            type="object"
                            string="Guardar Configuración"
                            class="btn-primary"
                            icon="fa-save"/>
                    <button name="action_test_ava_api_connection"
                            type="object"
                            string="Probar Token y Conexión con AVA_API"
                            class="btn-secondary"
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Configuración de Acceso a AVA_API</h1>
                        <p class="text-muted">
                            Ingresa los <strong>3 parámetros</strong> entregados para la API:
                            <strong>1. API Key</strong> (cabecera <code>X-Api-Key</code>),
                            <strong>2. ClientId</strong> y <strong>3. ClientSecret</strong> (cuerpo JSON en <code>POST /AVA/Token</code>).
                        </p>
                    </div>
                    <group>
                        <group string="Los 3 Parámetros de Autenticación (POST /AVA/Token)">
                            <field name="ava_api_key" password="True" placeholder="Pega aquí tu API Key (cabecera X-Api-Key)"/>
                            <field name="ava_api_client_id" placeholder="Pega aquí tu ClientId"/>
                            <field name="ava_api_client_secret" password="True" placeholder="Pega aquí tu ClientSecret"/>
                        </group>
                        <group string="Servidor y Tiempo de Espera">
                            <field name="ava_api_base_url" placeholder="https://sistemainforweb.com"/>
                            <field name="ava_api_timeout"/>
                        </group>
                    </group>
                    <separator string="Texto Legal por Defecto: Sección II (Objeto del Esquema Mensual)"/>
                    <group>
                        <field name="ava_default_scheme_objective"
                               widget="text"
                               nolabel="1"
                               colspan="2"
                               placeholder="Texto legal de la Sección II. OBJETO..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Bloque integrado también dentro de Ajustes Generales -> Empleados -->
    <record id="res_config_settings_view_form_ava_metas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ava.metas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="after">
                <block title="AVA_API y Esquema Mensual de Metas Comerciales" name="ava_api_sales_scheme_settings">
                    <setting string="3 Parámetros de Acceso a AVA_API (/AVA/Token, /AVA/ventas y /AVA/ventas/pagos)"
                             help="Configura API Key (X-Api-Key), ClientId y ClientSecret para obtener el access_token en POST /AVA/Token.">
                        <div class="content-group mt16">
                            <div class="row mt8">
                                <label for="ava_api_base_url" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_base_url" placeholder="https://sistemainforweb.com"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_key" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_key" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_client_id" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_client_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_client_secret" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_timeout" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_timeout"/>
                            </div>
                            <div class="mt16">
                                <button name="action_test_ava_api_connection"
                                        type="object"
                                        string="Probar Token y Conexión con AVA_API"
                                        class="btn-secondary"
                                        icon="fa-plug"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="Texto por Defecto del Objeto (Sección II)"
                             help="Texto legal preconfigurado que se cargará por defecto en la Sección II de cada nuevo Esquema Mensual de Metas Comerciales.">
                        <div class="content-group mt16">
                            <field name="ava_default_scheme_objective" widget="text" placeholder="Texto legal de la Sección II. OBJETO..."/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
