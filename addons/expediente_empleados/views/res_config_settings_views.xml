<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ava_metas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ava.metas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']" position="after">
                <block title="AVA_API y Esquema Mensual de Metas Comerciales" name="ava_api_sales_scheme_settings">
                    <setting string="Conexión a AVA_API (/AVA/ventas y /AVA/ventas/pagos)"
                             help="Configura la URL y credenciales para consultar las ventas y pagos de las agentes de ventas usando su 'Nombre Alias' (nombreVendedor).">
                        <div class="content-group mt16">
                            <div class="row mt8">
                                <label for="ava_api_base_url" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_base_url" placeholder="https://logichounds.com"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_catalogo" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_catalogo" placeholder="AVA01"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_auth_type" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_auth_type"/>
                            </div>
                            <div class="row mt8" invisible="ava_api_auth_type not in ['basic', 'none', 'bearer', 'api_key_header', 'api_key_query']">
                                <label for="ava_api_username" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_username"/>
                            </div>
                            <div class="row mt8" invisible="ava_api_auth_type != 'basic'">
                                <label for="ava_api_password" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_password" password="True"/>
                            </div>
                            <div class="row mt8" invisible="ava_api_auth_type not in ['bearer', 'api_key_header', 'api_key_query']">
                                <label for="ava_api_key" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_key" password="True"/>
                            </div>
                            <div class="row mt8" invisible="ava_api_auth_type not in ['api_key_header', 'api_key_query']">
                                <label for="ava_api_key_name" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_key_name"/>
                            </div>
                            <div class="row mt8">
                                <label for="ava_api_timeout" class="col-lg-4 o_light_label"/>
                                <field name="ava_api_timeout"/>
                            </div>
                            <div class="mt16">
                                <button name="action_test_ava_api_connection"
                                        type="object"
                                        string="Probar Conexión con AVA_API"
                                        class="btn-secondary"
                                        icon="fa-plug"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="Texto por Defecto del Objeto (Sección II)"
                             help="Texto legal preconfigurado que se cargará por defecto en la Sección II de cada nuevo Esquema Mensual de Metas Comerciales.">
                        <div class="content-group mt16">
                            <field name="ava_default_scheme_objective" widget="text" placeholder="Texto legal de la Sección II. OBJETO..."/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

